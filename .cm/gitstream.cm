# -*- mode: yaml -*-
manifest:
  version: 1.0

automations:
  performance_ai_review:
    # Review new PRs, PRs made ready for review, and new commits.
    on: [pr_created, pr_ready_for_review, commit]
    if:
      - {{ not pr.draft }}
      - {{ not (is.bot_author or is.bot_branch) }}
    run:
      - action: code-review@v1
        args:
          approve_on_LGTM: false
          issues_limit: 5
          guidelines: {{ "./performance-review-rules/COMBINED_PERF_RULES.md" | readFile() | dump }}

is:
  bot_author: {{ pr.author | match(list=['github-actions', '_bot_', '[bot]', 'dependabot']) | some }}
  bot_branch: {{ branch.name | match(list=['renovate/']) | some }}
